{
  "name": "@vis.gl/tangram-renderer",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Tangram vector-tile scene renderer powered by luma.gl",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./style-schema": {
      "import": "./dist/style-schema.js"
    },
    "./tangram-style.schema.json": "./dist/tangram-style.schema.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/tangram.gl.git",
    "directory": "modules/tangram-renderer"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "yarn build:nomodule && yarn build:nomodule:minify && yarn build:module && yarn build:module:minify && yarn build:entry && yarn build:style-schema && yarn generate-style-schema && yarn build:size",
    "build:entry": "node scripts/write-package-entry.mjs",
    "build:module": "ESM=true rollup -c",
    "build:nomodule": "ESM=false rollup -c",
    "build:module:minify": "ESM=true MINIFY=true rollup -c",
    "build:nomodule:minify": "ESM=false MINIFY=true rollup -c",
    "build:style-schema": "yarn --cwd ../.. ocular-bundle modules/tangram-renderer/src/styles/style-schema.ts --env=dev --format=esm --output=modules/tangram-renderer/dist/style-schema.js --externals=zod --sourcemap=true --sourcesContent=false",
    "generate-style-schema": "node scripts/generate-style-schema.mjs",
    "build:size": "gzip dist/tangram.min.mjs -c | wc -c | awk '{kb=$1/1024; print kb}' OFMT='Module:\\t\\t%.0fk (min/gzip)' && gzip dist/tangram.min.js -c | wc -c | awk '{kb=$1/1024; print kb}' OFMT='No module:\\t%.0fk (min/gzip)'",
    "prepack": "yarn build",
    "watch": "ESM=\"${ESM:=true}\" SERVE=true rollup -cw",
    "test-build-worker": "ESM=false rollup -c test/rollup.config.worker.js"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/plugin-transform-runtime": "^7.25.9",
    "@babel/preset-env": "^7.26.0",
    "@loaders.gl/config": "5.0.0-alpha.4",
    "@loaders.gl/core": "5.0.0-alpha.4",
    "@loaders.gl/mvt": "5.0.0-alpha.4",
    "@math.gl/web-mercator": "4.1.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-replace": "^6.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "rollup": "4.59.0",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-node-builtins": "^2.1.2",
    "rollup-plugin-node-globals": "^1.4.0",
    "rollup-plugin-serve": "^1.1.1",
    "rollup-plugin-sourcemaps2": "^0.4.2",
    "rollup-plugin-string-import": "^1.2.5"
  },
  "dependencies": {
    "@luma.gl/core": "^9.4.0",
    "@mapbox/vector-tile": "1.3.0",
    "core-js": "^3.39.0",
    "csscolorparser": "1.0.3",
    "earcut": "2.2.2",
    "fontfaceobserver": "2.0.7",
    "geojson-vt": "3.2.1",
    "gl-mat3": "1.0.0",
    "gl-mat4": "1.1.4",
    "gl-shader-errors": "1.0.3",
    "js-yaml": "https://github.com/tangrams/js-yaml.git#read-only",
    "jszip": "^3.10.1",
    "pbf": "3.1.0",
    "quickselect": "3.0.0",
    "topojson-client": "https://github.com/tangrams/topojson-client.git#read-only",
    "zod": "^4.1.12"
  }
}
