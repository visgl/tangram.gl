{
  "name": "@vis.gl/tangram-renderer",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Tangram vector-tile scene renderer powered by luma.gl",
  "homepage": "https://vis.gl/tangram.gl/",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/*": "./dist/*",
    "./core": {
      "types": "./dist/types/core.d.ts",
      "import": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./style-schema": {
      "import": "./dist/style-schema.js"
    },
    "./map-logic": {
      "types": "./dist/types/map-logic/index.d.ts",
      "import": "./dist/map-logic.js",
      "default": "./dist/map-logic.js"
    },
    "./experimental/shader-modules": {
      "types": "./dist/types/shader-modules/index.d.ts",
      "import": "./dist/shader-modules.js",
      "default": "./dist/shader-modules.js"
    },
    "./tangram-style.schema.json": "./dist/tangram-style.schema.json"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/tangram.gl.git",
    "directory": "modules/tangram-renderer"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "yarn build:types && node scripts/build.mjs && yarn build:entry && yarn build:map-logic && yarn build:shader-modules && yarn build:style-schema && yarn generate-style-schema && yarn build:loaders-gl-worker && yarn build:projection-worker && yarn build:size",
    "build:types": "node ../../scripts/build-package-types.mjs modules/tangram-renderer index.d.ts core.d.ts types.ts map-logic/index.ts shader-modules/index.ts",
    "build:shader-modules": "yarn --cwd ../.. ocular-bundle modules/tangram-renderer/src/shader-modules/index.ts --format=esm --output=modules/tangram-renderer/dist/shader-modules.js --externals=@vis.gl/tangram-layers --sourcemap=true --sourcesContent=false",
    "build:map-logic": "yarn --cwd ../.. ocular-bundle modules/tangram-renderer/src/map-logic/index.ts --format=esm --output=modules/tangram-renderer/dist/map-logic.js --externals=@vis.gl/tangram-layers --sourcemap=true --sourcesContent=false",
    "build:projection-worker": "yarn --cwd ../.. ocular-bundle modules/tangram-renderer/src/experimental/projected-basemaps-worker.ts --format=iife --globalName=TangramProjectedBasemaps --output=modules/tangram-renderer/dist/projected-basemaps-worker.js --externals=@vis.gl/tangram-layers --sourcemap=true --sourcesContent=false",
    "build:entry": "node scripts/write-package-entry.mjs",
    "build:style-schema": "yarn --cwd ../.. ocular-bundle modules/tangram-renderer/src/styles/style-schema.ts --env=dev --format=esm --output=modules/tangram-renderer/dist/style-schema.js --externals=zod --sourcemap=true --sourcesContent=false",
    "build:loaders-gl-worker": "yarn --cwd ../.. ocular-bundle modules/tangram-renderer/src/experimental/loaders-gl-worker.ts --format=iife --globalName=TangramLoadersGL --output=modules/tangram-renderer/dist/loaders-gl-worker.js --externals=@vis.gl/tangram-layers --sourcemap=true --sourcesContent=false",
    "generate-style-schema": "node scripts/generate-style-schema.mjs",
    "build:size": "gzip dist/tangram.min.mjs -c | wc -c | awk '{kb=$1/1000; print kb}' OFMT='Renderer ESM:\\t%.0f KB (min/gzip)'",
    "prepack": "yarn build",
    "watch": "node scripts/build.mjs --watch",
    "test-build-worker": "node scripts/build.mjs --test-worker"
  },
  "devDependencies": {
    "@loaders.gl/config": "5.0.0-alpha.11",
    "@loaders.gl/core": "5.0.0-alpha.11",
    "@loaders.gl/loader-utils": "5.0.0-alpha.11",
    "@loaders.gl/mlt": "5.0.0-alpha.11",
    "@loaders.gl/mvt": "5.0.0-alpha.11",
    "@loaders.gl/pmtiles": "5.0.0-alpha.11",
    "@loaders.gl/tiles": "5.0.0-alpha.11",
    "@math.gl/geospatial": "5.0.0-alpha.15",
    "@math.gl/projection": "5.0.0-alpha.15",
    "esbuild": "^0.28.1"
  },
  "dependencies": {
    "@luma.gl/core": "^9.4.2",
    "@luma.gl/shadertools": "^9.4.2",
    "@mapbox/vector-tile": "1.3.0",
    "@math.gl/core": "5.0.0-alpha.15",
    "@math.gl/culling": "5.0.0-alpha.15",
    "@math.gl/web-mercator": "5.0.0-alpha.15",
    "core-js": "^3.39.0",
    "csscolorparser": "1.0.3",
    "earcut": "2.2.2",
    "fontfaceobserver": "2.0.7",
    "geojson-vt": "3.2.1",
    "gl-shader-errors": "1.0.3",
    "js-yaml": "https://github.com/tangrams/js-yaml.git#read-only",
    "jszip": "^3.10.1",
    "pbf": "3.1.0",
    "quickselect": "3.0.0",
    "topojson-client": "https://github.com/tangrams/topojson-client.git#read-only",
    "zod": "^4.1.12"
  },
  "peerDependencies": {
    "@math.gl/projection": "5.0.0-alpha.15"
  },
  "peerDependenciesMeta": {
    "@math.gl/projection": {
      "optional": true
    }
  }
}
