{
  "name": "@tangram.gl/tangram-layers",
  "homepage": "https://vis.gl/tangram.gl/",
  "version": "0.0.0",
  "private": false,
  "description": "deck.gl layers for Tangram basemaps",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./experimental/webxr": {
      "types": "./src/experimental/webxr/index.d.ts",
      "import": "./dist/experimental/webxr.js",
      "default": "./dist/experimental/webxr.js"
    },
    "./experimental/projected-basemaps": {
      "types": "./dist/types/experimental/projected-basemaps.d.ts",
      "import": "./dist/experimental/projected-basemaps.js",
      "default": "./dist/experimental/projected-basemaps.js"
    },
    "./experimental/terrain": {
      "types": "./dist/types/experimental/terrain.d.ts",
      "import": "./dist/experimental/terrain.js",
      "default": "./dist/experimental/terrain.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/tangram.gl.git",
    "directory": "modules/tangram-layers"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "yarn build:types && yarn build:bundle",
    "build:types": "node ../../scripts/build-package-types.mjs modules/tangram-layers index.ts experimental/projected-basemaps.ts experimental/terrain.ts",
    "build:bundle": "yarn build:bundle:main && yarn build:bundle:webxr && yarn build:bundle:projected && yarn build:bundle:terrain",
    "build:bundle:terrain": "ocular-bundle ./experimental-terrain.js --env=dev --output=dist/experimental/terrain.js --externals=@tangram.gl/tangram-renderer --sourcemap=true --sourcesContent=false",
    "build:bundle:projected": "ocular-bundle ./experimental-projected-basemaps.js --env=dev --output=dist/experimental/projected-basemaps.js --externals=@tangram.gl/tangram-renderer --sourcemap=true --sourcesContent=false",
    "build:bundle:main": "ocular-bundle ./bundle.js --env=dev --output=dist/index.js --externals=@tangram.gl/tangram-renderer --sourcemap=true --sourcesContent=false",
    "build:bundle:webxr": "ocular-bundle ./experimental-webxr.js --env=dev --output=dist/experimental/webxr.js --externals=@tangram.gl/tangram-renderer --sourcemap=true --sourcesContent=false",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@vis.gl/dev-tools": "2.0.0-alpha.8",
    "playwright": "^1.58.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@math.gl/culling": "5.0.0-alpha.18",
    "@tangram.gl/tangram-renderer": "workspace:^"
  },
  "peerDependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/mesh-layers": "^9.4.0",
    "@luma.gl/core": "^9.4.2",
    "@luma.gl/experimental": "^9.4.2",
    "@math.gl/core": "5.0.0-alpha.18",
    "@math.gl/projection": "5.0.0-alpha.18",
    "mjolnir.js": "^3.1.0"
  },
  "peerDependenciesMeta": {
    "@deck.gl/mesh-layers": {
      "optional": true
    },
    "@math.gl/projection": {
      "optional": true
    }
  }
}
