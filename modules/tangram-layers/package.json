{
  "name": "@vis.gl/tangram-layers",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "deck.gl layers for Tangram basemaps",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./experimental/webxr": {
      "types": "./src/experimental/webxr/index.d.ts",
      "import": "./dist/experimental/webxr.js",
      "default": "./dist/experimental/webxr.js"
    },
    "./dist/*": "./dist/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/tangram.gl.git",
    "directory": "modules/tangram-layers"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "yarn build:bundle",
    "build:bundle": "yarn build:bundle:main && yarn build:bundle:webxr",
    "build:bundle:main": "ocular-bundle ./bundle.js --env=dev --output=dist/index.js --externals=@vis.gl/tangram-renderer --sourcemap=true --sourcesContent=false",
    "build:bundle:webxr": "ocular-bundle ./experimental-webxr.js --env=dev --output=dist/experimental/webxr.js --externals=@vis.gl/tangram-renderer --sourcemap=true --sourcesContent=false",
    "prepack": "yarn build"
  },
  "devDependencies": {
    "@vis.gl/dev-tools": "2.0.0-alpha.8",
    "playwright": "^1.58.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@vis.gl/tangram-renderer": "workspace:^"
  },
  "peerDependencies": {
    "@deck.gl/core": "^9.4.0",
    "@luma.gl/core": "^9.4.0",
    "@luma.gl/experimental": "^9.4.0",
    "@math.gl/core": "^4.1.0",
    "mjolnir.js": "^3.1.0"
  }
}
