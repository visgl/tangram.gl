{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["DOM", "DOM.Iterable", "ES2022", "WebWorker"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": true,
    "checkJs": false,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "paths": {
      "@tangram.gl/basemap-layers": ["./modules/basemap-layers/src/index.ts"],
      "@tangram.gl/basemap-layers/map-style": ["./modules/basemap-layers/src/map-style.ts"]
    }
  },
  "include": [
    "types/**/*.d.ts",
    "dev-modules/**/*",
    "modules/**/*",
    "examples/**/*",
    "test/**/*",
    "website/**/*"
  ],
  "exclude": [
    "**/build/**",
    "**/dist/**",
    "**/lib/**",
    "website/static/examples/**",
    "website/static/modules/**",
    "node_modules"
  ]
}
