{
  "name": "@vis.gl/tangram-classic",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Packaged Leaflet integration, classic Tangram playground, and style gallery",
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/build.mjs && yarn build:editor-workers",
    "build:editor-workers": "ocular-bundle ./monaco-editor.worker.js --format=iife --env=prod --output=dist/monaco-editor.worker.js && ocular-bundle ./monaco-json.worker.js --format=iife --env=prod --output=dist/monaco-json.worker.js",
    "start": "yarn workspace @vis.gl/tangram-renderer build && yarn build && node scripts/serve.mjs"
  },
  "dependencies": {
    "@vis.gl/tangram-renderer": "workspace:^"
  },
  "devDependencies": {
    "@deck.gl-community/panels": "9.4.2-beta.1",
    "@vis.gl/dev-tools": "2.0.0-alpha.8",
    "monaco-editor": "0.53.0",
    "playwright": "^1.58.0",
    "vitest": "^4.0.18"
  }
}
