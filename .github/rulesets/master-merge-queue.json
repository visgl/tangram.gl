{
  "name": "Master merge queue",
  "target": "branch",
  "enforcement": "active",
  "bypass_actors": [],
  "conditions": {
    "ref_name": {
      "include": ["refs/heads/master"],
      "exclude": []
    }
  },
  "rules": [
    {
      "type": "merge_queue",
      "parameters": {
        "merge_method": "SQUASH",
        "grouping_strategy": "ALLGREEN",
        "max_entries_to_build": 1,
        "min_entries_to_merge": 1,
        "max_entries_to_merge": 1,
        "min_entries_to_merge_wait_minutes": 0,
        "check_response_timeout_minutes": 60
      }
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": false,
        "required_status_checks": [
          {"context": "Generated artifact smoke test", "integration_id": 15368},
          {"context": "lint", "integration_id": 15368},
          {"context": "test-node", "integration_id": 15368},
          {"context": "test-headless", "integration_id": 15368},
          {"context": "Renderer coverage", "integration_id": 15368},
          {"context": "Rendering (webgl)", "integration_id": 15368},
          {"context": "Rendering (webgpu)", "integration_id": 15368},
          {"context": "test-website", "integration_id": 15368}
        ]
      }
    }
  ]
}
