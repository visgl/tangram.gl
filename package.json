{
  "name": "tangram-layers-monorepo",
  "version": "1.0.0-alpha.0",
  "private": true,
  "description": "Tangram rendering and deck.gl integration packages",
  "type": "module",
  "packageManager": "yarn@4.18.0",
  "workspaces": [
    "dev-modules/*",
    "modules/*",
    "examples/**/*",
    "website"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/visgl/tangram.gl.git"
  },
  "homepage": "https://vis.gl/tangram.gl/",
  "resolutions": {
    "@math.gl/core@npm:5.0.0-alpha.15": "5.0.0-alpha.18",
    "@math.gl/crs@npm:5.0.0-alpha.15": "5.0.0-alpha.18",
    "@math.gl/culling@npm:5.0.0-alpha.15": "5.0.0-alpha.18",
    "@math.gl/dggs@npm:5.0.0-alpha.15": "5.0.0-alpha.18",
    "@math.gl/geoid@npm:5.0.0-alpha.15": "5.0.0-alpha.18",
    "@math.gl/geometry-utils@npm:5.0.0-alpha.15": "5.0.0-alpha.18",
    "@math.gl/geospatial@npm:5.0.0-alpha.15": "5.0.0-alpha.18",
    "@math.gl/polygon@npm:5.0.0-alpha.15": "5.0.0-alpha.18",
    "@math.gl/projection@npm:5.0.0-alpha.15": "5.0.0-alpha.18",
    "@math.gl/types@npm:5.0.0-alpha.15": "5.0.0-alpha.18",
    "@math.gl/web-mercator@npm:5.0.0-alpha.15": "5.0.0-alpha.18",
    "@math.gl/wkb@npm:5.0.0-alpha.15": "5.0.0-alpha.18",
    "@loaders.gl/arrow@npm:4.5.1": "4.5.3",
    "@loaders.gl/worker-utils@npm:4.5.4": "4.5.3"
  },
  "scripts": {
    "start": "yarn workspace @vis.gl/tangram-renderer watch",
    "bootstrap": "yarn install && ocular-bootstrap",
    "clean": "ocular-clean",
    "website:start": "yarn workspace tangram-layers-website start",
    "website:build": "yarn workspace tangram-layers-website build",
    "build": "yarn clean && yarn build:modules && yarn workspace @vis.gl/tangram-classic build && yarn workspace @vis.gl/tangram-terrain-example build && yarn build:examples",
    "build:modules": "yarn workspace @vis.gl/tangram-renderer build && yarn workspace @vis.gl/tangram-layers build && yarn build:artifacts",
    "build:artifacts": "node scripts/check-renderer-artifacts.mjs",
    "build:packages": "yarn build",
    "bundle-size": "yarn build:modules && node scripts/report-bundle-size.mjs",
    "bundle-size:parsers": "node scripts/report-parser-bundle-size.mjs",
    "bundle-size:tilesets": "node scripts/report-tileset-bundle-size.mjs",
    "bundle-size:projections": "node scripts/report-projection-bundle-size.mjs",
    "coverage:scope": "node scripts/check-coverage-scope.mjs",
    "lint": "yarn lint:licenses && ocular-lint && yarn typescript:scope",
    "lint:fix": "yarn lint:licenses:fix && ocular-lint fix",
    "lint:licenses": "node scripts/check-license-headers.mjs",
    "lint:licenses:fix": "node scripts/check-license-headers.mjs --write",
    "test": "yarn lint && yarn test-node && yarn test-headless",
    "test-fast": "yarn lint && yarn test-node",
    "test-node": "ocular-test node",
    "test-terrain-contracts": "ocular-test terrain-conformance",
    "test-browser": "yarn build:modules && yarn test-build-worker && yarn workspace @vis.gl/tangram-classic build:editor-workers && ocular-test browser",
    "test-headless": "yarn build:modules && yarn test-build-worker && yarn workspace @vis.gl/tangram-classic build:editor-workers && ocular-test headless",
    "test-rendering": "yarn build:modules && yarn test-rendering:run",
    "test-rendering:run": "yarn build:examples && vitest run --config vitest.rendering.config.ts",
    "test-coverage": "yarn build:modules && yarn test-build-worker && yarn workspace @vis.gl/tangram-classic build:editor-workers && ocular-test headless --coverage",
    "typecheck": "tsc --noEmit",
    "typescript:scope": "node scripts/check-typescript-migration.mjs",
    "playwright:install": "playwright install chromium",
    "test-website": "yarn website:build",
    "test-build-worker": "yarn workspace @vis.gl/tangram-renderer test-build-worker && yarn workspace @vis.gl/tangram-terrain-example build",
    "publish:beta": "ocular-publish version-only-beta",
    "publish:prod": "ocular-publish version-only-prod",
    "build:examples": "node scripts/build-examples.mjs"
  },
  "devDependencies": {
    "@deck.gl/core": "^9.4.0",
    "@math.gl/spatial-index": "5.0.0-alpha.18",
    "@vis.gl/dev-tools": "2.0.0-alpha.8",
    "@vitest/coverage-v8": "^4.0.18",
    "chai": "^4.5.0",
    "esbuild": "^0.28.1",
    "playwright": "^1.58.0",
    "sinon": "^19.0.2",
    "typescript": "^6.0.3",
    "vitest": "^4.0.18"
  }
}
